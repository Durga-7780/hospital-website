[Unit]
Description=Hospital Website Backend
After=network.target

[Service]
User=root
Group=root

WorkingDirectory=/var/www/html/hospital-website/backend

Environment="PATH=/var/www/html/hospital-website/backend/venv/bin"

ExecStart=/var/www/html/hospital-website/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 20266

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
